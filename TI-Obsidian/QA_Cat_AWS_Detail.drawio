          </mxCell>
        </object>
        <mxCell id="front-icon" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;fillColor=#8C4FFF;strokeColor=#FFFFFF;aspect=fixed;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="front">
          <mxGeometry as="geometry" x="12" y="19.0" width="42" height="42" />
        </mxCell>
        <mxCell id="api" value="02  TI API :8000" style="rounded=1;arcSize=12;fillColor=#F5F8FC;strokeColor=#2878B8;strokeWidth=1.5;fontColor=#243746;fontSize=16;spacing=10;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="acc-a">
          <mxGeometry as="geometry" x="335" y="65" width="245" height="80" />
        </mxCell>
        <object id="jobs" label="03  Job Controller&#10;S07 · Law 4.3" tooltip="TI controls S01–S10, Git diff analysis and S04 risk tier. Dispatches jobs and PinnedContext; execution completion is not PASS." provenance="User architecture brief; design view, not runtime verification">
          <mxCell style="rounded=1;arcSize=12;fillColor=#F5F8FC;strokeColor=#2878B8;strokeWidth=1.5;fontColor=#243746;fontSize=16;spacing=10;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="acc-a">
            <mxGeometry as="geometry" x="335" y="225" width="245" height="80" />
          </mxCell>
        </object>
        <object id="store" label="07  S08 Evidence&#10;Object Lock · SHA-256" tooltip="Law 16. Evidence ingestion endpoint in Account A writes to S3, verifies hashes and applies retention/Object Lock. Local runner folders are staging only." provenance="User architecture brief; design view, not runtime verification">
          <mxCell style="rounded=1;arcSize=12;fillColor=#F5F8FC;strokeColor=#2878B8;strokeWidth=1.5;fontColor=#243746;fontSize=16;spacing=10;spacingLeft=60;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="acc-a">
