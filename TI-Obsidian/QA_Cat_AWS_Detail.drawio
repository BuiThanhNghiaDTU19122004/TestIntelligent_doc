  <diagram id="05-TI" name="05-TI Topology">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#FFFFFF" tooltips="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="TI / AWS • mô hình tích hợp đề xuất" style="text;align=left;verticalAlign=middle;fontSize=26;fontColor=#243746;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1">
