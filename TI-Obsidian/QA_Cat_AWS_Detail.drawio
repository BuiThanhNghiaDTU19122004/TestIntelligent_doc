        </mxCell>
        <object id="browser" label="AgentCore Browser&#10;Production" tooltip="AWS managed browser; CDP authenticated by SigV4. DCV Web Viewer iframe 1920×1080 and Take Control for keyboard/mouse." provenance="User architecture brief; design view, not runtime verification">
