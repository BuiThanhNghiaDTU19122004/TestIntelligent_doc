        <object id="secrets" label="Secrets Manager" tooltip="EC2 role fetches read-only GitHub deploy key and QA_AGENT_WS_TOKEN at boot. No static AWS credentials on disk. GitHub deploy requires separately approved outbound path; SSM is not GitHub connectivity." provenance="User architecture brief; design view, not runtime verification">
          <mxCell style="rounded=1;arcSize=12;fillColor=#F5F8FC;strokeColor=#2878B8;strokeWidth=1.5;fontColor=#243746;fontSize=16;spacing=10;spacingLeft=60;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="cloud">
