          <mxGeometry as="geometry" x="12" y="19.0" width="42" height="42" />
        </mxCell>
        <mxCell id="gate" value="08  S09 Decision Gate&#10;Law 18" style="rounded=1;arcSize=12;fillColor=#F5F8FC;strokeColor=#167D8D;strokeWidth=1.5;fontColor=#243746;fontSize=16;spacing=10;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="acc-a">
          <mxGeometry as="geometry" x="30" y="555" width="245" height="80" />
        </mxCell>
        <mxCell id="vpc" value="VPC D9 • private subnets • no NAT / IGW" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc;container=1;pointerEvents=0;collapsible=0;fillColor=none;strokeColor=#8052B8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=35;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#8052B8;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="acc-b">
          <mxGeometry as="geometry" x="25" y="195" width="610" height="405" />
        </mxCell>
        <object id="private" label="04  Private endpoints" tooltip="Proposed cross-region PrivateLink endpoint services (NLB-backed): dispatch into B; evidence ingestion into A. Enable supported regions and allowed principals. AWS service endpoints are distinct from this service-to-service path." provenance="User architecture brief; design view, not runtime verification">
          <mxCell style="rounded=1;arcSize=12;fillColor=#F5F8FC;strokeColor=#2878B8;strokeWidth=1.5;fontColor=#243746;fontSize=16;spacing=10;spacingLeft=60;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="vpc">
            <mxGeometry as="geometry" x="20" y="65" width="250" height="80" />
          </mxCell>
        </object>
        <mxCell id="private-icon" value="" style="shape=mxgraph.aws4.endpoint;fillColor=#8C4FFF;strokeColor=#FFFFFF;aspect=fixed;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="private">
          <mxGeometry as="geometry" x="12" y="19.0" width="42" height="42" />
        </mxCell>
        <object id="runners" label="05  Fargate runners&#10;D3 QA Cat  |  D5b Pentest" tooltip="IsolatedRunner, Law 23. D3 QA Cat at S07; D5b Pentest at Wave 3. Tasks have no public IP. AgentCore is a managed service outside the task, not a container inside Fargate." provenance="User architecture brief; design view, not runtime verification">
          <mxCell style="rounded=1;arcSize=12;fillColor=#F5F8FC;strokeColor=#2878B8;strokeWidth=1.5;fontColor=#243746;fontSize=16;spacing=10;spacingLeft=60;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="vpc">
            <mxGeometry as="geometry" x="320" y="65" width="265" height="110" />
          </mxCell>
        </object>
        <mxCell id="runners-icon" value="" style="shape=mxgraph.aws4.container_1;fillColor=#ED7100;strokeColor=#FFFFFF;aspect=fixed;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="runners">
          <mxGeometry as="geometry" x="12" y="34.0" width="42" height="42" />
        </mxCell>
        <object id="policy" label="IAM task role · STS&#10;SG + endpoint policies" tooltip="Design guardrails: least privilege; short-lived role credentials; scoped AssumeRole only where needed; trust policy and resource policy. D9 denies all egress except approved endpoints and explicitly authorized targets. ECR API/DKR, S3 image layers, Logs, Secrets, STS and Bedrock connectivity must be provisioned." provenance="User architecture brief; design view, not runtime verification">
          <mxCell style="rounded=1;arcSize=12;fillColor=#F5F8FC;strokeColor=#BC4141;strokeWidth=1.5;fontColor=#243746;fontSize=16;spacing=10;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="vpc">
            <mxGeometry as="geometry" x="20" y="265" width="250" height="80" />
          </mxCell>
        </object>
        <object id="target" label="Authorized targets&#10;Private / allowlisted" tooltip="No arbitrary public target under deny-all. Provide a private path or an explicitly approved egress mechanism. Endpoint access to AWS does not grant internet access to test targets." provenance="User architecture brief; design view, not runtime verification">
          <mxCell style="rounded=1;arcSize=12;fillColor=#F5F8FC;strokeColor=#BC4141;strokeWidth=1.5;fontColor=#243746;fontSize=16;spacing=10;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="vpc">
            <mxGeometry as="geometry" x="320" y="265" width="265" height="80" />
          </mxCell>
        </object>
        <object id="bedrock" label="06  Bedrock / AgentCore&#10;Managed services" tooltip="Bedrock: Claude 3.7 / Opus 4.7 planning, critic and judges; Sonnet 4 executor; Titan Embed v2. Model names are supplied configuration, not verified regional availability. AgentCore via approved service connectivity; CDP SigV4 and DCV." provenance="User architecture brief; design view, not runtime verification">
          <mxCell style="rounded=1;arcSize=12;fillColor=#F5F8FC;strokeColor=#2878B8;strokeWidth=1.5;fontColor=#243746;fontSize=16;spacing=10;spacingLeft=60;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="acc-b">
