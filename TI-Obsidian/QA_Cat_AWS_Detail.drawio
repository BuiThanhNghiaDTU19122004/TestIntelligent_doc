          <mxGeometry as="geometry" x="40" y="845" width="1320" height="30" />
        </mxCell>
        <mxCell id="acc-a" value="ACCOUNT A  /  ap-southeast-1" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;container=1;pointerEvents=0;collapsible=0;fillColor=none;strokeColor=#243746;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=35;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#243746;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="120" width="620" height="680" />
        </mxCell>
        <mxCell id="acc-b" value="ACCOUNT B  /  us-east-1" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;container=1;pointerEvents=0;collapsible=0;fillColor=none;strokeColor=#243746;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=35;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#243746;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="120" width="660" height="680" />
        </mxCell>
        <object id="front" label="01  CloudFront&#10;+ WAF" tooltip="TI ingress. Origin connectivity is deployment-specific; not specified by the brief." provenance="User architecture brief; design view, not runtime verification">
          <mxCell style="rounded=1;arcSize=12;fillColor=#F5F8FC;strokeColor=#2878B8;strokeWidth=1.5;fontColor=#243746;fontSize=16;spacing=10;spacingLeft=60;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="acc-a">
