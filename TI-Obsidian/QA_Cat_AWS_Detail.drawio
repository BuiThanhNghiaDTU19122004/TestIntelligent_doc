        </mxCell>
        <mxCell id="subtitle" value="Control plane quyết định; QA Cat và Pentest chỉ thực thi. Các đường private cần triển khai endpoint service tương ứng." style="text;align=left;verticalAlign=middle;fontSize=13;fontColor=#607386;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1">
