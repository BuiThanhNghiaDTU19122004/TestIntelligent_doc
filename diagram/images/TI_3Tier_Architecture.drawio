<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="tier3-framework" name="1. 3-Tier Architecture Framework">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Header Title Banner -->
        <mxCell id="header" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;MÔ HÌNH HỢP NHẤT 3 TẦNG KIẾN TRÚC TESTING INTELLIGENCE (TI)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px; opacity: 0.9;&quot;&gt;Master Architecture Blueprint — Não bộ AI (Task 3&amp;amp;4) · Hồn Điều Phối Ports &amp;amp; Adapters (DevOps) · Xác Hạ Tầng Điện Toán Cô Lập (Task 1&amp;amp;2)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fillColor=#1a237e;strokeColor=#0d47a1;fontColor=#ffffff;align=center;verticalAlign=middle;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="55" as="geometry" />
        </mxCell>

        <!-- TIER 1: AI & BUSINESS EVALUATION -->
        <mxCell id="tier1_box" value="&lt;b style=&quot;font-size: 14.5px;&quot;&gt;TẦNG 1: TRÍ TUỆ NHÂN TẠO &amp;amp; ĐÁNH GIÁ NGHIỆP VỤ (Task 3 &amp;amp; Task 4)&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=1.5;fontColor=#4a148c;fontFamily=Segoe UI, Arial, sans-serif;rounded=1;arcSize=6;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1100" height="150" as="geometry" />
        </mxCell>

        <mxCell id="tier1_c1" value="&lt;b style=&quot;font-size: 13.5px;&quot;&gt;Bedrock Model Tiering (Task 3)&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;span style=&quot;font-size: 12px; line-height: 1.4;&quot;&gt;• &lt;b&gt;Haiku 4.5&lt;/b&gt;: Template &amp;amp; Parse JSON thô&lt;br&gt;• &lt;b&gt;Sonnet 5&lt;/b&gt;: Lập kế hoạch S05 &amp;amp; Sinh test S06&lt;br&gt;• &lt;b&gt;Opus 5&lt;/b&gt;: S04 Threat Modeling (khi Risk CRITICAL)&lt;br&gt;&lt;span style=&quot;color: #2e7d32; font-weight: bold;&quot;&gt;➔ Tiết kiệm 65–75% chi phí token&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fillColor=#ffffff;strokeColor=#ba68c8;fontColor=#212121;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="tier1_box">
          <mxGeometry x="20" y="42" width="335" height="96" as="geometry" />
        </mxCell>

        <mxCell id="tier1_c2" value="&lt;b style=&quot;font-size: 13.5px;&quot;&gt;Chuỗi S01–S10 &amp;amp; ToolIntent (Law 10.1)&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;span style=&quot;font-size: 12px; line-height: 1.4;&quot;&gt;• 10 chặng: Mã cứng vs AI suy luận vs Tool đo lường&lt;br&gt;• AI chỉ phát sinh &lt;b&gt;ToolIntent JSON&lt;/b&gt; (Symbolic Params)&lt;br&gt;• &lt;b&gt;Law 10.1 &amp;amp; 13&lt;/b&gt;: Tuyệt đối không chứa secret / URL thật&lt;br&gt;&lt;span style=&quot;color: #d32f2f; font-weight: bold;&quot;&gt;➔ Triệt tiêu rủi ro lộ lọt bí mật&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fillColor=#ffffff;strokeColor=#ba68c8;fontColor=#212121;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="tier1_box">
          <mxGeometry x="380" y="42" width="340" height="96" as="geometry" />
        </mxCell>

        <mxCell id="tier1_c3" value="&lt;b style=&quot;font-size: 13.5px;&quot;&gt;Khung Đo Lường ISTQB CT-AI / GenAI&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;span style=&quot;font-size: 12px; line-height: 1.4;&quot;&gt;• &lt;b&gt;Law 5 &amp;amp; 7&lt;/b&gt;: Đo bằng tool thật · Zero Self-Declaration&lt;br&gt;• &lt;b&gt;Bedrock Evals&lt;/b&gt;: Groundedness &amp;ge; 0.80, Faithfulness &amp;ge; 0.85&lt;br&gt;• Temperature: 0.0 (Greedy Decoding ±0.03)&lt;br&gt;&lt;span style=&quot;color: #1565c0; font-weight: bold;&quot;&gt;➔ Loại bỏ 100% kịch bản ảo giác&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fillColor=#ffffff;strokeColor=#ba68c8;fontColor=#212121;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="tier1_box">
          <mxGeometry x="745" y="42" width="335" height="96" as="geometry" />
        </mxCell>

        <!-- SINGLE-LINE CONNECTOR: TIER 1 -> TIER 2 -->
        <mxCell id="proto1" value="&lt;b&gt;GIAO THỨC 1: ToolIntent JSON (Law 10.1 &amp;amp; 13)&lt;/b&gt; — Symbolic Params, Zero Credentials, Server-Owned Binding" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#7b1fa2;strokeWidth=1.5;fontColor=#4a148c;labelBackgroundColor=#ffffff;endArrow=block;endSize=6;" edge="1" parent="1" source="tier1_box" target="tier2_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TIER 2: ABSTRACTION & PORTS AND ADAPTERS -->
        <mxCell id="tier2_box" value="&lt;b style=&quot;font-size: 14.5px;&quot;&gt;TẦNG 2: TRỪU TƯỢNG HÓA &amp;amp; NGUYÊN LÝ KIẾN TRÚC (DevOps / Hà Tây Nguyên)&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=1.5;fontColor=#0d47a1;fontFamily=Segoe UI, Arial, sans-serif;rounded=1;arcSize=6;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="295" width="1100" height="150" as="geometry" />
        </mxCell>

        <mxCell id="tier2_c1" value="&lt;b style=&quot;font-size: 13.5px;&quot;&gt;Triết lý Ports &amp;amp; Adapters (Hexagonal)&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;span style=&quot;font-size: 12px; line-height: 1.4;&quot;&gt;• Kiến trúc cắm ghép (Plugin Architecture)&lt;br&gt;• Tách biệt Core Logic khỏi công cụ test cụ thể&lt;br&gt;• Thay thế Runner không chạm một dòng code lõi&lt;br&gt;&lt;span style=&quot;color: #1565c0; font-weight: bold;&quot;&gt;➔ Triệt tiêu rủi ro Vendor Lock-in&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fillColor=#ffffff;strokeColor=#90caf9;fontColor=#212121;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="tier2_box">
          <mxGeometry x="20" y="42" width="335" height="96" as="geometry" />
        </mxCell>

        <mxCell id="tier2_c2" value="&lt;b style=&quot;font-size: 13.5px;&quot;&gt;Interface Chuẩn Hóa IsolatedRunner (Law 23)&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;span style=&quot;font-size: 12px; line-height: 1.4;&quot;&gt;• Contract TypeScript: &lt;code&gt;executeJob(input): Promise&amp;lt;Result&amp;gt;&lt;/code&gt;&lt;br&gt;• In: &lt;i&gt;imageDigest, command[], tenantBindingRef, limits&lt;/i&gt;&lt;br&gt;• Out: &lt;i&gt;exitCode, rawResultPath, logsPath, sha256Digest&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;color: #2e7d32; font-weight: bold;&quot;&gt;➔ Chuẩn hóa giao tiếp 100% độc lập hạ tầng&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fillColor=#ffffff;strokeColor=#90caf9;fontColor=#212121;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="tier2_box">
          <mxGeometry x="380" y="42" width="340" height="96" as="geometry" />
        </mxCell>

        <mxCell id="tier2_c3" value="&lt;b style=&quot;font-size: 13.5px;&quot;&gt;Control Plane vs Execution Engine&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;span style=&quot;font-size: 12px; line-height: 1.4;&quot;&gt;• &lt;b&gt;Law 4.3&lt;/b&gt;: Job Controller giữ sổ cái PostgreSQL duy nhất&lt;br&gt;• Quản lý Worker Lease TTL 5m &amp;amp; nhịp tim Heartbeat&lt;br&gt;• &lt;b&gt;Law 18&lt;/b&gt;: &lt;i&gt;completed &amp;ne; PASS&lt;/i&gt; (Gate S09 độc lập)&lt;br&gt;&lt;span style=&quot;color: #e65100; font-weight: bold;&quot;&gt;➔ Thẩm quyền điều phối tập trung &amp;amp; minh bạch&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fillColor=#ffffff;strokeColor=#90caf9;fontColor=#212121;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="tier2_box">
          <mxGeometry x="745" y="42" width="335" height="96" as="geometry" />
        </mxCell>

        <!-- SINGLE-LINE CONNECTOR: TIER 2 -> TIER 3 -->
        <mxCell id="proto2" value="&lt;b&gt;GIAO THỨC 2: Direct Dispatch có Worker Lease (Law 23 &amp;amp; 13)&lt;/b&gt; — Tra cứu TenantBinding · Cấp STS Token · Gọi ECS RunTask" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#2e7d32;strokeWidth=1.5;fontColor=#1b5e20;labelBackgroundColor=#ffffff;endArrow=block;endSize=6;" edge="1" parent="1" source="tier2_box" target="tier3_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TIER 3: CLOUD INFRASTRUCTURE & SECURITY -->
        <mxCell id="tier3_box" value="&lt;b style=&quot;font-size: 14.5px;&quot;&gt;TẦNG 3: HẠ TẦNG ĐIỆN TOÁN ĐÁM MÂY &amp;amp; AN NINH MẠNG (Task 1 &amp;amp; Task 2)&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;fontColor=#1b5e20;fontFamily=Segoe UI, Arial, sans-serif;rounded=1;arcSize=6;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="495" width="1100" height="150" as="geometry" />
        </mxCell>

        <mxCell id="tier3_c1" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;AWS 2 Accounts Độc Lập&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;span style=&quot;font-size: 11.5px; line-height: 1.4;&quot;&gt;• &lt;b&gt;Account A (Singapore)&lt;/b&gt;: Backend API, Job Store, S3 Object Lock&lt;br&gt;• &lt;b&gt;Account B (us-east-1)&lt;/b&gt;: Bedrock AI Models tiên tiến nhất&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fillColor=#ffffff;strokeColor=#a5d6a7;fontColor=#212121;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="tier3_box">
          <mxGeometry x="20" y="42" width="250" height="96" as="geometry" />
        </mxCell>

        <mxCell id="tier3_c2" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;ECS Fargate Task-per-Job&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;span style=&quot;font-size: 11.5px; line-height: 1.4;&quot;&gt;• Domain D2: Cô lập MicroVM Nitro&lt;br&gt;• Tự hủy sau khi test, trả theo giây&lt;br&gt;• Không EC2 idle (~$5–$15/tháng)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fillColor=#ffffff;strokeColor=#a5d6a7;fontColor=#212121;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="tier3_box">
          <mxGeometry x="290" y="42" width="250" height="96" as="geometry" />
        </mxCell>

        <mxCell id="tier3_c3" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Mạng D9 Tối Ưu (~$22/tháng)&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;span style=&quot;font-size: 11.5px; line-height: 1.4;&quot;&gt;• Bỏ Network Firewall ($288/tháng)&lt;br&gt;• Private Subnet: SG DENY ALL EGRESS&lt;br&gt;• 3 VPC Endpoints (S3 $0, ECR, STS)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fillColor=#ffffff;strokeColor=#a5d6a7;fontColor=#212121;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="tier3_box">
          <mxGeometry x="560" y="42" width="260" height="96" as="geometry" />
        </mxCell>

        <mxCell id="tier3_c4" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Aurora Serverless v2 Clone&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;span style=&quot;font-size: 11.5px; line-height: 1.4;&quot;&gt;• Domain D2.b: Snapshot &amp;lt; 60 giây&lt;br&gt;• Test Flyway &amp;amp; SQLAlchemy schema&lt;br&gt;• Hủy ngay sau test (~$10/tháng)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fillColor=#ffffff;strokeColor=#a5d6a7;fontColor=#212121;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="tier3_box">
          <mxGeometry x="840" y="42" width="240" height="96" as="geometry" />
        </mxCell>

        <!-- FOOTER: CORE ARCHITECTURE LAWS ENFORCED -->
        <mxCell id="footer" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;TI 24 ARCHITECTURE LAWS:&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;font-size: 11.5px;&quot;&gt;• &lt;b&gt;Law 4.3&lt;/b&gt;: Workflow Authority &amp;nbsp;• &lt;b&gt;Law 5 &amp;amp; 7&lt;/b&gt;: Zero AI Self-Declaration &amp;nbsp;• &lt;b&gt;Law 10.1 &amp;amp; 13&lt;/b&gt;: Server Binding &amp;nbsp;• &lt;b&gt;Law 16&lt;/b&gt;: WORM S3 Digest &amp;nbsp;• &lt;b&gt;Law 18&lt;/b&gt;: completed &amp;ne; PASS &amp;nbsp;• &lt;b&gt;Law 23&lt;/b&gt;: IsolatedRunner&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fillColor=#eceff1;strokeColor=#90a4ae;fontColor=#37474f;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="665" width="1100" height="38" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
