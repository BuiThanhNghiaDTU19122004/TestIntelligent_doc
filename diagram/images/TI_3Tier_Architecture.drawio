        <mxCell id="tier1_c1" value="&lt;b style=&quot;font-size: 15.5px; color: #4a148c;&quot;&gt;Bedrock Dual-Model Tiering&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;span style=&quot;font-size: 13.5px; line-height: 1.45;&quot;&gt;• &lt;b&gt;Sonnet 5&lt;/b&gt;: S05 Planning &amp;amp; S06 Gen TestCases&lt;br&gt;• &lt;b&gt;Opus 5&lt;/b&gt;: S04 Threat Modeling (Risk CRITICAL)&lt;br&gt;&lt;span style=&quot;color: #2e7d32; font-weight: bold;&quot;&gt;➔ Tối ưu 65–75% chi phí Token&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=13.5;fillColor=#ffffff;strokeColor=#ba68c8;fontColor=#212121;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="tier1_box">
