        <mxCell id="t_dast" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;D5b DAST Task (W3)&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size: 11.5px; color: #555;&quot;&gt;OWASP ZAP, Nuclei&lt;/b&gt;&lt;hr style=&quot;margin: 3px 0;&quot;&gt;&lt;span style=&quot;font-size: 11px; color: #444;&quot;&gt;• Dynamic Fuzzing&lt;br&gt;• Chỉ chạy khi có Staging URL&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fillColor=#ffebee;strokeColor=#e53935;fontColor=#b71c1c;align=left;spacingLeft=8;" vertex="1" parent="runners_box">
          <mxGeometry x="1035" y="34" width="250" height="102" as="geometry" />
        </mxCell>

        <!-- Aurora Clone Box -->
        <mxCell id="aurora_clone" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Amazon Aurora Serverless v2 Clone (Domain D2.b)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11.5px;&quot;&gt;Copy-on-Write sạch &amp;lt; 60s từ Staging · Không tốn dung lượng snapshot · Tự hủy sau khi test (~$10–$20/th)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;align=center;" vertex="1" parent="zone_sandbox">
          <mxGeometry x="25" y="278" width="1300" height="52" as="geometry" />
        </mxCell>

        <mxCell id="fargate_note" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;CƠ CHẾ TASK-PER-JOB:&lt;/b&gt; Mỗi bài test là 1 ECS Fargate Task cô lập MicroVM. Tuyệt đối KHÔNG có Fargate lồng Fargate! Tự hủy, thanh toán theo giây." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fillColor=#e0f2f1;strokeColor=#00897b;fontColor=#004d40;fontSize=11.5;align=center;" vertex="1" parent="zone_sandbox">
          <mxGeometry x="25" y="342" width="1300" height="32" as="geometry" />
        </mxCell>

        <!-- ======================================================== -->
        <!-- EDGES & DATA FLOWS (10 CHẶNG ĐÁNH SỐ CHUẨN XÁC) -->
        <!-- ======================================================== -->

        <!-- Edge 1: Caller -> CloudFront -->
