        <!-- Edge 8: Runner/S3 -> State Machine -->
        <mxCell id="e8" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;[8] Báo Cáo Hoàn Tất + Envelope ~2KB&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;dashed=1;strokeColor=#1565c0;strokeWidth=2;fontColor=#0d47a1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="runners_box" target="lease_node">
