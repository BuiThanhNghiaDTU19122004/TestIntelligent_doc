        </mxCell>

        <!-- Edge 4: Harness -> AgentCore Gateway -->
        <mxCell id="e4" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;[4] ToolIntent JSON (Symbolic)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#7b1fa2;strokeWidth=1.5;fontColor=#4a148c;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="har_node" target="gateway_node">
