        <!-- Edge 10: Caller Polls CloudFront -->
        <mxCell id="e10" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;[10] GET /v2/artifact-jobs/{id} (PASS / HOLD / DO_NOT_PASS)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;dashed=1;strokeColor=#b71c1c;strokeWidth=1.5;fontColor=#b71c1c;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cf_node" target="zone_ext">
