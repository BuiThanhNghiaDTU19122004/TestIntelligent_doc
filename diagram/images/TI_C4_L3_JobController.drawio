  <diagram id="c4-l3-job-controller" name="3. C4 L3 Job Controller Deep Dive">
    <mxGraphModel dx="1800" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="640" math="0" shadow="0">
      <root>
