        <!-- Header Title Banner -->
        <mxCell id="header_l3" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;SƠ ĐỒ C4 LEVEL 3: ZOOM SÂU BÊN TRONG JOB CONTROLLER (WORKFLOW AUTHORITY)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; opacity: 0.95;&quot;&gt;Phân Giải TenantBinding &amp;amp; Dispatch Ngang Hàng Sang Cụm Task Fargate — Triệt Tiêu Anti-pattern Fargate Lồng Fargate&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fillColor=#1a237e;strokeColor=#0d47a1;fontColor=#ffffff;align=center;verticalAlign=middle;arcSize=6;shadow=1;" vertex="1" parent="1">
