        <!-- FOOTER BAR -->
        <mxCell id="footer_seq" value="&lt;b style=&quot;font-size: 14.5px;&quot;&gt;BẢO CHỨNG BỞI ARCHITECTURE LAWS:&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;font-size: 13.5px;&quot;&gt;• &lt;b&gt;Law 4.3&lt;/b&gt;: Sổ cái thẩm quyền duy nhất &amp;nbsp;• &lt;b&gt;Law 5 &amp;amp; 7&lt;/b&gt;: Zero AI Self-Declaration &amp;nbsp;• &lt;b&gt;Law 10.1 &amp;amp; 13&lt;/b&gt;: ToolIntent không mang secret &amp;nbsp;• &lt;b&gt;Law 16&lt;/b&gt;: S3 WORM SHA-256 &amp;nbsp;• &lt;b&gt;Law 18&lt;/b&gt;: completed &amp;ne; PASS &amp;nbsp;• &lt;b&gt;Law 23&lt;/b&gt;: IsolatedRunner contract&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;fillColor=#eceff1;strokeColor=#90a4ae;fontColor=#37474f;align=center;verticalAlign=middle;" vertex="1" parent="1">
