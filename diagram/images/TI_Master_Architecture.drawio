        </mxCell>
        <!-- 17. JC self-loop: S09 Deterministic Gate -->
        <mxCell id="msg17" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;17. Gate S09 Deterministic Code Barrier&lt;/b&gt; (Zero AI Self-Declaration - Law 5 &amp;amp; 7)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#1976d2;strokeWidth=1.5;fontColor=#0d47a1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="615" y="1035" as="sourcePoint" />
            <mxPoint x="615" y="1070" as="targetPoint" />
            <Array as="points">
              <mxPoint x="685" y="1035" />
              <mxPoint x="685" y="1070" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- 18. JC -> DB: Update COMPLETED -->
        <mxCell id="msg18" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;18. Update State: COMPLETED&lt;/b&gt; (PASS / HOLD / DO_NOT_PASS - Law 18)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#388e3c;strokeWidth=1.5;fontColor=#1b5e20;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="615" y="1095" as="sourcePoint" />
            <mxPoint x="855" y="1095" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- ======================================================== -->
        <!-- PHASE 5: POLLING & WAIVER APPROVAL -->
        <!-- ======================================================== -->
