        <mxCell id="phase4_box" value="&lt;b style=&quot;font-size: 14.5px;&quot;&gt;GIAI ĐOẠN 4: ĐÓNG BẰNG CHỨNG BẤT BIẾN &amp;amp; PHÁN QUYẾT GATE S09 (DETERMINISTIC BARRIER)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fillColor=#e1f5fe;strokeColor=#81d4fa;fontColor=#0277bd;align=left;spacingLeft=14;" vertex="1" parent="1">
