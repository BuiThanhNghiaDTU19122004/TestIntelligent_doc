        <!-- Header Title Banner -->
        <mxCell id="header_seq" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;SÆ  Äá»’ SEQUENCE: VÃ’NG Äá»œI Xá»¬ LÃ JOB Tá»ª TIáº¾P NHáº¬N Äáº¾N GATE S09&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; opacity: 0.95;&quot;&gt;Luá»“ng tÆ°Æ¡ng tÃ¡c 8 thá»±c thá»ƒ xuyÃªn suá»‘t 2 AWS Accounts, Fargate Sandbox, S3 Object Lock &amp;amp; Cá»•ng phÃª duyá»‡t ngoáº¡i lá»‡&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fillColor=#1a237e;strokeColor=#0d47a1;fontColor=#ffffff;align=center;verticalAlign=middle;arcSize=6;shadow=1;" vertex="1" parent="1">
