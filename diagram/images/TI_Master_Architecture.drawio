        <mxCell id="tier2_c2" value="&lt;b style=&quot;font-size: 15.5px; color: #0d47a1;&quot;&gt;Interface IsolatedRunner (Law 23)&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;span style=&quot;font-size: 13.5px; line-height: 1.45;&quot;&gt;• Contract: &lt;code&gt;executeJob(input): Promise&amp;lt;Result&amp;gt;&lt;/code&gt;&lt;br&gt;• Input: imageDigest, command[], tenantRef&lt;br&gt;&lt;span style=&quot;color: #2e7d32; font-weight: bold;&quot;&gt;➔ Chuẩn hóa 100% độc lập hạ tầng&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=13.5;fillColor=#ffffff;strokeColor=#90caf9;fontColor=#212121;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="tier2_box">
