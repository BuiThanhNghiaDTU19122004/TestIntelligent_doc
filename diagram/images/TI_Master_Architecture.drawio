        <!-- ======================================================== -->
        <!-- EDGES & DATA FLOWS ([1] - [10]) -->
        <!-- ======================================================== -->
        <!-- Edge 1: Caller -> CloudFront -->
        <mxCell id="e1" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;[1] POST /v2/artifact-jobs&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#d32f2f;strokeWidth=2;fontColor=#b71c1c;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="zone_ext" target="cf_node">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
