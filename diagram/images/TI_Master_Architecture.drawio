        <!-- ======================================================== -->
        <!-- PHASE 3: ISOLATED RUNNER SANDBOX EXECUTION (S07) -->
        <!-- ======================================================== -->
        <mxCell id="phase3_box" value="&lt;b style=&quot;font-size: 12.5px;&quot;&gt;GIAI ĐOẠN 3: ĐIỀU PHỐI &amp;amp; THỰC THI SANDBOX CÔ LẬP (S07) — PRIVATE SUBNET D9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fillColor=#e8f5e9;strokeColor=#a5d6a7;fontColor=#1b5e20;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="585" width="1820" height="28" as="geometry" />
        </mxCell>
        <!-- 9. JC self-loop: TenantBinding & STS -->
        <mxCell id="msg9" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;9. Resolve TenantBinding &amp;amp; cấp STS Short-lived Creds&lt;/b&gt; (Law 13)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#1976d2;strokeWidth=1.5;fontColor=#0d47a1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
