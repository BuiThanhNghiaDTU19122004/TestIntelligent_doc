      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="seq-lifecycle" name="4. Sequence Lifecycle &amp; Gate S09">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Header Title Banner -->
        <mxCell id="header_seq" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;SƠ ĐỒ SEQUENCE: VÒNG ĐỜI XỬ LÝ JOB TỪ TIẾP NHẬN ĐẾN GATE S09&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; opacity: 0.95;&quot;&gt;Luồng tương tác 8 thực thể xuyên suốt 2 AWS Accounts, Fargate Sandbox, S3 Object Lock &amp;amp; Cổng phê duyệt ngoại lệ&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fillColor=#1a237e;strokeColor=#0d47a1;fontColor=#ffffff;align=center;verticalAlign=middle;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1880" height="60" as="geometry" />
        </mxCell>
        <!-- ======================================================== -->
        <!-- 8 LIFELINES -->
        <!-- ======================================================== -->
        <!-- 1. Caller -->
        <mxCell id="ll_caller" value="&lt;b style=&quot;font-size: 13.5px;&quot;&gt;CI / Developer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11.5px;&quot;&gt;(Caller)&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f5f5f5;strokeColor=#616161;fontColor=#212121;size=46;" vertex="1" parent="1">
          <mxGeometry x="50" y="95" width="170" height="1245" as="geometry" />
        </mxCell>
        <!-- 2. TI API v2 with AWS ECS Icon -->
        <mxCell id="ll_api" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;TI API v2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;(Account A :8000)&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#e8eaf6;strokeColor=#3f51b5;fontColor=#1a237e;size=46;spacingLeft=36;align=left;" vertex="1" parent="1">
          <mxGeometry x="290" y="95" width="170" height="1245" as="geometry" />
        </mxCell>
        <!-- AWS ECS Icon on TI API v2 Lifeline -->
        <mxCell id="icon_ll_api" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecs;" vertex="1" parent="ll_api">
          <mxGeometry x="8" y="7" width="32" height="32" as="geometry" />
        </mxCell>
        <!-- 3. Job Controller -->
