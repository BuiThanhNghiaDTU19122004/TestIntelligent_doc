        <!-- Opt Waiver Frame -->
        <mxCell id="opt_waiver" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;opt&lt;/b&gt; &lt;span style=&quot;font-size: 13px;&quot;&gt;[Nếu Gate là HOLD: Có phát hiện cần phê duyệt ngoại lệ]&lt;/span&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;width=350;height=22;fillColor=none;strokeColor=#d32f2f;strokeWidth=1.5;fontColor=#b71c1c;fontFamily=Roboto, Helvetica, Arial, sans-serif;" vertex="1" parent="1">
