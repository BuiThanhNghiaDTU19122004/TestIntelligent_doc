        <mxCell id="ll_qa" value="&lt;b style=&quot;font-size: 13.5px;&quot;&gt;QA Lead / Authority&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11.5px;&quot;&gt;(Cổng Duyệt Ngoại Lệ)&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#fff8e1;strokeColor=#ffa000;fontColor=#ff6f00;size=46;" vertex="1" parent="1">
          <mxGeometry x="1730" y="95" width="170" height="1245" as="geometry" />
        </mxCell>
        <!-- ======================================================== -->
        <!-- PHASE 1: ADMISSION & IMMEDIATE ACCEPTANCE -->
        <!-- ======================================================== -->
        <mxCell id="phase1_box" value="&lt;b style=&quot;font-size: 12.5px;&quot;&gt;GIAI ĐOẠN 1: TIẾP NHẬN &amp;amp; PHẢN HỒI BẤT ĐỒNG BỘ TỨC THÌ (ADMISSION LAYER)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fillColor=#f0f4c3;strokeColor=#c0ca33;fontColor=#827717;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="155" width="1820" height="28" as="geometry" />
        </mxCell>
        <!-- 1. Caller -> API -->
        <mxCell id="msg1" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;1. POST /v2/artifact-jobs&lt;/b&gt; (Artifact + SHA-256)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#1565c0;strokeWidth=1.5;fontColor=#0d47a1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="135" y="195" as="sourcePoint" />
            <mxPoint x="375" y="195" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- 2. API -> JC -->
        <mxCell id="msg2" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;2. Enqueue Job &amp;amp; Schema Validate&lt;/b&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#1565c0;strokeWidth=1.5;fontColor=#0d47a1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="375" y="230" as="sourcePoint" />
            <mxPoint x="615" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- 3. JC -> DB -->
        <mxCell id="msg3" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;3. Ghi QUEUED &amp;amp; Token Budget&lt;/b&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#388e3c;strokeWidth=1.5;fontColor=#1b5e20;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="615" y="265" as="sourcePoint" />
            <mxPoint x="855" y="265" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- 4. API to Caller (Async Response) -->
        <mxCell id="msg4" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;4. 202 Accepted {job_id}&lt;/b&gt; (Giải phóng kết nối &amp;lt; 1s)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#d32f2f;strokeWidth=1.5;fontColor=#b71c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="375" y="300" as="sourcePoint" />
            <mxPoint x="135" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- ======================================================== -->
        <!-- PHASE 2: AI ANALYSIS & CANDIDATE GENERATION (S01 - S06) -->
        <!-- ======================================================== -->
        <mxCell id="phase2_box" value="&lt;b style=&quot;font-size: 12.5px;&quot;&gt;GIAI ĐOẠN 2: PHÂN TÍCH TÁC ĐỘNG &amp;amp; SINH KỊCH BẢN (S01–S06) — ACCOUNT B (us-east-1)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fillColor=#ede7f6;strokeColor=#b39ddb;fontColor=#4a148c;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="340" width="1820" height="28" as="geometry" />
        </mxCell>
        <!-- 5. JC -> Harness -->
        <mxCell id="msg5" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;5. InvokeHarness&lt;/b&gt; (Context, AST diff, Token Budget)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#7b1fa2;strokeWidth=1.5;fontColor=#4a148c;labelBackgroundColor=#ffffff;" edge="1" parent="1">
