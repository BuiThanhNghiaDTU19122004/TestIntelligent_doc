        <!-- 13. Fargate self-loop test execution -->
        <mxCell id="msg13" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;13. Thực thi kiểm thử cô lập&lt;/b&gt; (Playwright/k6/Flyway/Semgrep - NO-INTERNET)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#2e7d32;strokeWidth=1.5;fontColor=#1b5e20;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1335" y="820" as="sourcePoint" />
            <mxPoint x="1335" y="855" as="targetPoint" />
