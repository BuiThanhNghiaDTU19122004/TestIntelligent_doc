        <!-- 5. Bedrock Harness -->
        <mxCell id="ico_harness" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="1168" y="112" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ll_harness" value="&lt;b style=&quot;font-size: 15.5px;&quot;&gt;Bedrock Harness&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13.5px;&quot;&gt;(Account B - us-east-1)&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontColor=#4a148c;size=52;" vertex="1" parent="1">
          <mxGeometry x="1090" y="105" width="190" height="1360" as="geometry" />
        </mxCell>
        <!-- 6. Fargate Sandbox -->
