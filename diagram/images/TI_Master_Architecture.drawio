        <!-- Header Title Banner -->
        <mxCell id="header" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;MÔ HÌNH HỢP NHẤT 3 TẦNG KIẾN TRÚC TESTING INTELLIGENCE (TI) [CANDIDATE]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 14px; opacity: 0.95;&quot;&gt;Master Architecture Blueprint — Não bộ AI (Account B) · Hồn Điều Phối Ports &amp;amp; Adapters (Account A) · Xác Hạ Tầng Fargate Sandbox&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fillColor=#1a237e;strokeColor=#0d47a1;fontColor=#ffffff;align=center;verticalAlign=middle;arcSize=6;" vertex="1" parent="1">
