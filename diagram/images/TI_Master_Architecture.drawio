        <mxCell id="tier1_c3" value="&lt;b style=&quot;font-size: 15.5px; color: #4a148c;&quot;&gt;Đo Lường Chất Lượng &amp;amp; Hallucination&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;&gt;&lt;span style=&quot;font-size: 13.5px; line-height: 1.45;&quot;&gt;• &lt;b&gt;Bedrock Evals&lt;/b&gt;: Groundedness &amp;ge; 0.80, Faith &amp;ge; 0.85&lt;br&gt;• Đo bằng tool thật · Zero Self-Declaration (Law 5&amp;amp;7)&lt;br&gt;&lt;span style=&quot;color: #1565c0; font-weight: bold;&quot;&gt;➔ Kiểm soát độ tin cậy AI tuyệt đối&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=13.5;fillColor=#ffffff;strokeColor=#ba68c8;fontColor=#212121;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="tier1_box">
