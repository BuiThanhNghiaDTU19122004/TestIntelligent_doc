        <mxCell id="e2" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;[2] Enqueue (202 Accepted &amp;lt;1s)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#1565c0;strokeWidth=2;fontColor=#0d47a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api_node" target="adm_node">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Internal Account A: Adm -> State -> DB -->
        <mxCell id="e_state" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;strokeColor=#1976d2;strokeWidth=1.5;" edge="1" parent="1" source="adm_node" target="state_node">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pg" value="&lt;span style=&quot;font-size: 13px;&quot;&gt;Ghi PENDING&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=13;strokeColor=#388e3c;strokeWidth=1.5;fontColor=#1b5e20;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state_node" target="db_pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Edge 3: Job Controller -> Account B (Harness) -->
        <mxCell id="e3" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;[3] Task Context (Law 10.1)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#7b1fa2;strokeWidth=2;fontColor=#4a148c;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="adm_node" target="har_node">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Internal Account B: Har -> Tiering & Policy -->
        <mxCell id="e_tier" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;strokeColor=#512da8;strokeWidth=1.5;" edge="1" parent="1" source="har_node" target="tier_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pol" value="&lt;span style=&quot;font-size: 13px;&quot;&gt;Evals &amp;ge; 0.80&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=13;strokeColor=#7b1fa2;strokeWidth=1.5;fontColor=#4a148c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tier_box" target="policy_node">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Edge 4: Harness -> AgentCore Gateway -->
        <mxCell id="e4" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;[4] ToolIntent JSON (Symbolic)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#7b1fa2;strokeWidth=2;fontColor=#4a148c;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="har_node" target="gateway_node">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Edge 5: AgentCore Gateway -> Job Controller (Resolver) -->
        <mxCell id="e5" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;[5] Validated ToolIntent&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#1976d2;strokeWidth=2;fontColor=#0d47a1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="gateway_node" target="resolver_node">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="325" />
              <mxPoint x="580" y="570" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- Edge 6: Resolver -> Fargate Runners -->
        <mxCell id="e6" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;[6] Direct Dispatch + STS Creds&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#2e7d32;strokeWidth=2;fontColor=#1b5e20;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="resolver_node" target="runners_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- DB Runner connection to Aurora Clone -->
        <mxCell id="e_db_clone" value="&lt;span style=&quot;font-size: 13px;&quot;&gt;Migration &amp;amp; Schema&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=13;dashed=1;strokeColor=#8e24aa;strokeWidth=1.5;fontColor=#4a148c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_db" target="aurora_clone">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Edge 7: Fargate Runners -> S3 Object Lock -->
        <mxCell id="e7" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;[7] Direct-to-S3 Raw Evidence (Law 16)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#2e7d32;strokeWidth=2;fontColor=#1b5e20;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=1;entryY=0.5;" edge="1" parent="1" source="runners_box" target="s3_evi">
