              <mxPoint x="1405" y="855" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- 14. Fargate -> S3: Raw Evidence -->
        <mxCell id="msg14" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;14. Direct-to-S3 Offloading:&lt;/b&gt; Ghi Raw Logs, Video, Traces ($0 VPC Gateway)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#2e7d32;strokeWidth=1.5;fontColor=#1b5e20;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1335" y="885" as="sourcePoint" />
            <mxPoint x="1575" y="885" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- 15. Fargate to JC Finished -->
        <mxCell id="msg15" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;15. Báo cáo hoàn tất tác vụ&lt;/b&gt; (Finished + Envelope ~2 KB)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#2e7d32;strokeWidth=1.5;fontColor=#1b5e20;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1335" y="920" as="sourcePoint" />
            <mxPoint x="615" y="920" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- ======================================================== -->
        <!-- PHASE 4: EVIDENCE DIGEST & GATE S09 BARRIER -->
        <!-- ======================================================== -->
        <mxCell id="phase4_box" value="&lt;b style=&quot;font-size: 12.5px;&quot;&gt;GIAI ĐOẠN 4: ĐÓNG BẰNG CHỨNG BẤT BIẾN &amp;amp; PHÁN QUYẾT GATE S09 (DETERMINISTIC BARRIER)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fillColor=#e1f5fe;strokeColor=#81d4fa;fontColor=#0277bd;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="960" width="1820" height="28" as="geometry" />
        </mxCell>
        <!-- 16. JC -> S3: Object Lock -->
        <mxCell id="msg16" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;16. Băm SHA-256 Digest &amp;amp; Khóa S3 Object Lock&lt;/b&gt; (WORM 90 ngày - Law 16)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#388e3c;strokeWidth=1.5;fontColor=#1b5e20;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="615" y="1000" as="sourcePoint" />
            <mxPoint x="1575" y="1000" as="targetPoint" />
