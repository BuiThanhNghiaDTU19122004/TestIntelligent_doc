              <mxPoint x="550" y="591" />
              <mxPoint x="550" y="812" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- Edge 8: Runner/S3 -> State Machine -->
        <mxCell id="e8" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;[8] Báo Cáo Hoàn Tất + Envelope ~2KB&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;dashed=1;strokeColor=#1565c0;strokeWidth=1.5;fontColor=#0d47a1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="runners_box" target="lease_node">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Edge 9: S3 Evidence -> AgentCore Memory -->
        <mxCell id="e9" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;[9] GOLDEN Tri Thức (S10)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;dashed=1;strokeColor=#7b1fa2;strokeWidth=1.5;fontColor=#4a148c;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=1;entryY=0.5;" edge="1" parent="1" source="s3_evi" target="mem_node">
          <mxGeometry relative="1" as="geometry">
