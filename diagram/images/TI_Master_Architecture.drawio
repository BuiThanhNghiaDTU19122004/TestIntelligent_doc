        <mxCell id="e1b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;strokeColor=#1565c0;strokeWidth=1.5;" edge="1" parent="1" source="cf_node" target="api_node">
          <mxGeometry relative="1" as="geometry" />
