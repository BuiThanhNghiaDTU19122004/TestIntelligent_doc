            <mxPoint x="615" y="660" as="targetPoint" />
            <Array as="points">
              <mxPoint x="685" y="625" />
              <mxPoint x="685" y="660" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- 10. JC -> DB: Update RUNNING -->
        <mxCell id="msg10" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;10. Update Step: RUNNING&lt;/b&gt; (Lease TTL 5 mins)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#388e3c;strokeWidth=1.5;fontColor=#1b5e20;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="615" y="685" as="sourcePoint" />
            <mxPoint x="855" y="685" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- 11. JC -> Fargate: RunTask -->
        <mxCell id="msg11" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;11. Direct Dispatch: ECS RunTask&lt;/b&gt; (Launch Fargate Task-per-Job)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#2e7d32;strokeWidth=1.5;fontColor=#1b5e20;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="615" y="720" as="sourcePoint" />
            <mxPoint x="1335" y="720" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Loop Heartbeat Frame -->
        <mxCell id="loop_hb" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;loop&lt;/b&gt; &lt;span style=&quot;font-size: 11px;&quot;&gt;[Heartbeat định kỳ 60s]&lt;/span&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;width=180;height=20;fillColor=none;strokeColor=#4caf50;strokeWidth=1.5;fontColor=#2e7d32;fontFamily=Segoe UI, Arial, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="575" y="745" width="800" height="52" as="geometry" />
        </mxCell>
        <!-- 12. Fargate to JC Heartbeat -->
        <mxCell id="msg12" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;12. Gửi Heartbeat gia hạn Worker Lease TTL&lt;/b&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#388e3c;strokeWidth=1.5;fontColor=#1b5e20;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1335" y="775" as="sourcePoint" />
            <mxPoint x="615" y="775" as="targetPoint" />
