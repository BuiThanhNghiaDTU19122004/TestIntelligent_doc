  <diagram id="tier3-framework" name="1. 3-Tier Architecture Framework">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="920" math="0" shadow="0">
      <root>
