        <!-- 6. Harness self-loop S03 & S04 -->
        <mxCell id="msg6" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;6. S03 Impact &amp;amp; S04 Risk Tiering&lt;/b&gt; (Opus 5 nếu Risk == CRITICAL)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;strokeColor=#7b1fa2;strokeWidth=1.5;fontColor=#4a148c;labelBackgroundColor=#ffffff;" edge="1" parent="1">
