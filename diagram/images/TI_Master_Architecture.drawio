        <mxCell id="legend_bar" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;CHÚ THÍCH:&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;background-color: #e8eaf6; padding: 2px 8px; border: 1px solid #3f51b5; font-size: 12px;&quot;&gt;Account A: ap-southeast-1 [OBSERVED]&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;background-color: #f3e5f5; padding: 2px 8px; border: 1px solid #7b1fa2; font-size: 12px;&quot;&gt;Account B: us-east-1 Bedrock AI [OBSERVED]&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;background-color: #e8f5e9; padding: 2px 8px; border: 1px solid #2e7d32; font-size: 12px;&quot;&gt;Sandbox VPC: Fargate Enclave [CANDIDATE]&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;background-color: #f5f5f5; padding: 2px 8px; border: 1px solid #616161; font-size: 12px;&quot;&gt;External Callers&lt;/span&gt;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&lt;b style=&quot;font-size: 12.5px;&quot;&gt;Luồng Dữ Liệu:&lt;/b&gt; Tuần tự từ &lt;b&gt;[1]&lt;/b&gt; đến &lt;b&gt;[10]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12.5;fillColor=#eceff1;strokeColor=#90a4ae;fontColor=#37474f;align=center;verticalAlign=middle;" vertex="1" parent="1">
