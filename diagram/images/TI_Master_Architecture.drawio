          </mxGeometry>
        </mxCell>
        <!-- FOOTER BAR -->
        <mxCell id="footer_l3" value="&lt;b style=&quot;font-size: 12.5px;&quot;&gt;NGUYÊN LÝ CỐT LÕI:&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;font-size: 12px;&quot;&gt;1. Tiếp nhận &amp;amp; validate &amp;nbsp;➔&amp;nbsp; 2. Sổ cái quản trị Lease thời hạn &amp;nbsp;➔&amp;nbsp; 3. Resolve TenantBinding &amp;nbsp;➔&amp;nbsp; 4. Dispatch Fargate Tasks độc lập MicroVM &amp;nbsp;➔&amp;nbsp; 5. Khóa S3 WORM 90 ngày&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI, Arial, sans-serif;fontSize=12;fillColor=#eceff1;strokeColor=#90a4ae;fontColor=#37474f;align=center;verticalAlign=middle;" vertex="1" parent="1">
