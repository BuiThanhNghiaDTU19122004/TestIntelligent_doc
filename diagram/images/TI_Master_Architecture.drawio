        <!-- ======================================================== -->
        <mxCell id="phase1_box" value="&lt;b style=&quot;font-size: 14.5px;&quot;&gt;GIAI ĐOẠN 1: TIẾP NHẬN &amp;amp; PHẢN HỒI BẤT ĐỒNG BỘ TỨC THÌ (ADMISSION LAYER)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fillColor=#f0f4c3;strokeColor=#c0ca33;fontColor=#827717;align=left;spacingLeft=14;" vertex="1" parent="1">
