        <!-- ======================================================== -->
        <!-- PHASE 1: ADMISSION & IMMEDIATE ACCEPTANCE -->
        <!-- ======================================================== -->
        <mxCell id="phase1_box" value="&lt;b style=&quot;font-size: 14.5px;&quot;&gt;GIAI ĐOẠN 1: TIẾP NHẬN &amp;amp; PHẢN HỒI BẤT ĐỒNG BỘ TỨC THÌ (ADMISSION LAYER)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fillColor=#f0f4c3;strokeColor=#c0ca33;fontColor=#827717;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="175" width="2040" height="32" as="geometry" />
        </mxCell>

        <!-- 1. Caller -> API -->
        <mxCell id="msg1" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;1. POST /v2/artifact-jobs&lt;/b&gt; (Artifact + SHA-256)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#1565c0;strokeWidth=2;fontColor=#0d47a1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="145" y="220" as="sourcePoint" />
            <mxPoint x="405" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 2. API -> JC -->
        <mxCell id="msg2" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;2. Enqueue Job &amp;amp; Validate Schema&lt;/b&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#1565c0;strokeWidth=2;fontColor=#0d47a1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="405" y="258" as="sourcePoint" />
            <mxPoint x="665" y="258" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 3. JC -> DB -->
        <mxCell id="msg3" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;3. Ghi QUEUED &amp;amp; Quản lý Token Budget&lt;/b&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#388e3c;strokeWidth=2;fontColor=#1b5e20;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="665" y="296" as="sourcePoint" />
            <mxPoint x="925" y="296" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 4. API to Caller (Async Response) -->
        <mxCell id="msg4" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;4. 202 Accepted {job_id}&lt;/b&gt; (Giải phóng kết nối &amp;lt; 1s)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#d32f2f;strokeWidth=2;fontColor=#b71c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="405" y="335" as="sourcePoint" />
            <mxPoint x="145" y="335" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ======================================================== -->
        <!-- PHASE 2: AI ANALYSIS & CANDIDATE GENERATION (S01 - S06) -->
        <!-- ======================================================== -->
        <mxCell id="phase2_box" value="&lt;b style=&quot;font-size: 14.5px;&quot;&gt;GIAI ĐOẠN 2: PHÂN TÍCH TÁC ĐỘNG &amp;amp; SINH KỊCH BẢN (S01–S06) — ACCOUNT B (us-east-1)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fillColor=#ede7f6;strokeColor=#b39ddb;fontColor=#4a148c;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="2040" height="32" as="geometry" />
        </mxCell>

        <!-- 5. JC -> Harness -->
        <mxCell id="msg5" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;5. InvokeHarness&lt;/b&gt; (Context, AST diff, Token Budget)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#7b1fa2;strokeWidth=2;fontColor=#4a148c;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
