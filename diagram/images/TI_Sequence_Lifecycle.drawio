              <mxPoint x="1260" y="465" />
              <mxPoint x="1260" y="505" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 7. AgentCore Gateway Validation -->
        <mxCell id="msg7" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;7. AgentCore Gateway &amp;amp; Policy Enforce&lt;/b&gt; (Chặn secret, Bedrock Evals &amp;ge; 0.80)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#7b1fa2;strokeWidth=2;fontColor=#4a148c;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1185" y="535" as="sourcePoint" />
            <mxPoint x="1185" y="575" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1260" y="535" />
              <mxPoint x="1260" y="575" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 8. Harness to JC (ToolIntent Response) -->
        <mxCell id="msg8" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;8. Trả ToolIntent JSON&lt;/b&gt; (Symbolic Action, không secret - Law 10.1)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#7b1fa2;strokeWidth=2;fontColor=#4a148c;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1185" y="615" as="sourcePoint" />
            <mxPoint x="665" y="615" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ======================================================== -->
        <!-- PHASE 3: ISOLATED RUNNER SANDBOX EXECUTION (S07) -->
        <!-- ======================================================== -->
        <mxCell id="phase3_box" value="&lt;b style=&quot;font-size: 14.5px;&quot;&gt;GIAI ĐOẠN 3: ĐIỀU PHỐI &amp;amp; THỰC THI SANDBOX CÔ LẬP (S07) — PRIVATE SUBNET D9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fillColor=#e8f5e9;strokeColor=#a5d6a7;fontColor=#1b5e20;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="2040" height="32" as="geometry" />
        </mxCell>

        <!-- 9. JC self-loop: TenantBinding & STS -->
        <mxCell id="msg9" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;9. Resolve TenantBinding &amp;amp; Cấp STS Creds&lt;/b&gt; (Law 10.1 &amp;amp; 13 - JC Thẩm Quyền)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#1976d2;strokeWidth=2;fontColor=#0d47a1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="665" y="705" as="sourcePoint" />
            <mxPoint x="665" y="745" as="targetPoint" />
            <Array as="points">
              <mxPoint x="740" y="705" />
              <mxPoint x="740" y="745" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 10. JC -> DB: Update RUNNING -->
        <mxCell id="msg10" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;10. Update Step: RUNNING&lt;/b&gt; (Worker Lease TTL 5 phút)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#388e3c;strokeWidth=2;fontColor=#1b5e20;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="665" y="775" as="sourcePoint" />
            <mxPoint x="925" y="775" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 11. JC -> Fargate: RunTask -->
        <mxCell id="msg11" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;11. Direct Dispatch: ECS RunTask&lt;/b&gt; (Launch Fargate Task-per-Job MicroVM)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#2e7d32;strokeWidth=2;fontColor=#1b5e20;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="665" y="815" as="sourcePoint" />
            <mxPoint x="1445" y="815" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Loop Heartbeat Frame -->
        <mxCell id="loop_hb" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;loop&lt;/b&gt; &lt;span style=&quot;font-size: 13px;&quot;&gt;[Heartbeat định kỳ 60s / Lease TTL 5m]&lt;/span&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;width=240;height=22;fillColor=none;strokeColor=#4caf50;strokeWidth=1.5;fontColor=#2e7d32;fontFamily=Roboto, Helvetica, Arial, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="620" y="845" width="870" height="58" as="geometry" />
        </mxCell>

        <!-- 12. Fargate to JC Heartbeat -->
        <mxCell id="msg12" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;12. Gửi Heartbeat gia hạn Worker Lease TTL&lt;/b&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#388e3c;strokeWidth=2;fontColor=#1b5e20;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1445" y="880" as="sourcePoint" />
            <mxPoint x="665" y="880" as="targetPoint" />
          </mxGeometry>
