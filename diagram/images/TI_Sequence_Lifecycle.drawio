            <mxPoint x="1185" y="425" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 6. Harness self-loop S05 & S06 -->
        <mxCell id="msg6" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;6. S05 Planning &amp;amp; S06 Gen TestCases&lt;/b&gt; (Sonnet 5; Opus 5 nếu Threat CRITICAL)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=1;fontFamily=Roboto, Helvetica, Arial, sans-serif;fontSize=14;strokeColor=#7b1fa2;strokeWidth=2;fontColor=#4a148c;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
